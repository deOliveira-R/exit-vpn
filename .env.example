# Copy to .env next to compose.yaml (chmod 600). Defaults shown.

# The images (published releases, pinned by digest: copy them from the release's images.env;
# `deploy/rollout.sh` sets them). Not needed with compose.build.yaml.
EXIT_IMAGE=ghcr.io/deoliveira-r/exit-vpn-exit:1.0.0@sha256:<digest>
PROBER_IMAGE=ghcr.io/deoliveira-r/exit-vpn-prober:1.0.0@sha256:<digest>

# Tailnet node name and container name: exit-<provider>
EXIT_NODE_NAME=exit-proton
# WireGuard config for the active tunnel, a file in ./secrets (standard wg-quick format)
EXIT_VPN_CONF=proton_a.conf
# The provider's in-tunnel DNS server (the DNS line of the config). Proton: 10.2.0.1
VPN_DNS=10.2.0.1
WG_MTU=1420
# IPv6 through the exit: on (default) routes it via the tunnel wherever the server carries it
# (proven by the health probe; elsewhere it fails fast and clients use IPv4); off: never
EXIT_IPV6=on
# Tag(s) the node logs in with; must be in the policy's tagOwners (and autoApprovers)
TS_TAGS=tag:exit
# tailscaled UDP port, published on the host (the host's own tailscaled uses 41641)
TS_PORT=41642
# The Tailscale auth key is ./secrets/ts_authkey (used only for the first login)
EXIT_MEMORY=512m
# Docker bridge for the stack; must not overlap other Docker networks on the host
EXITNET_SUBNET=172.30.42.0/24

# Controller API: tailnet login names allowed (comma-separated, e.g. alice@github)
EXIT_OWNERS=
# Failover/rotation country preference, in order (catalog country names)
EXIT_COUNTRIES=United States,Switzerland
VPN_PROVIDER=proton
# Server catalog (empty: the pinned default in controller/src/exit_vpn/config.py)
CATALOG_URL=
API_PORT=8080

# Prober: its own WireGuard config (key B) and fixed addresses on exitnet
PROBE_VPN_CONF=proton_b.conf
EXIT_IP=172.30.42.2
PROBER_IP=172.30.42.10
PROBER_MEMORY=2g
