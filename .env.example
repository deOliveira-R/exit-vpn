# Copy to .env next to compose.yaml (chmod 600). Defaults shown.

# Tailnet node name and container name: exit-<provider>
EXIT_NODE_NAME=exit-proton
# WireGuard config for the active tunnel, a file in ./secrets (standard wg-quick format)
EXIT_VPN_CONF=proton_a.conf
# The provider's in-tunnel DNS server (the DNS line of the config). Proton: 10.2.0.1
VPN_DNS=10.2.0.1
WG_MTU=1420
# Tag(s) the node logs in with; must be in the policy's tagOwners (and autoApprovers)
TS_TAGS=tag:exit
# tailscaled UDP port, published on the host (the host's own tailscaled uses 41641)
TS_PORT=41642
# The Tailscale auth key is ./secrets/ts_authkey (used only for the first login)
EXIT_MEMORY=512m
# Docker bridge for the stack; must not overlap other Docker networks on the host
EXITNET_SUBNET=172.30.42.0/24
