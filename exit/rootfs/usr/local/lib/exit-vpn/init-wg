#!/command/with-contenv sh
# Bring up the tunnel. The interface is created once and kept; server
# changes are peer swaps. Peer: last-good from state, else the config's own peer.
. /usr/local/lib/exit-vpn/common.sh
load_conf

peer_pubkey=$CONF_PEER_PUBKEY; peer_endpoint=$CONF_PEER_ENDPOINT
if [ -r "$STATE_DIR/peer.env" ]; then
  # shellcheck disable=SC1091
  . "$STATE_DIR/peer.env"   # PEER_PUBKEY, PEER_ENDPOINT, PEER_NAME
  peer_pubkey=${PEER_PUBKEY:-$peer_pubkey}; peer_endpoint=${PEER_ENDPOINT:-$peer_endpoint}
fi

ip link del "$WG_IF" 2>/dev/null || true
ip link add "$WG_IF" type wireguard
# The private key goes to wg via a pipe, never via argv or a file outside /secrets.
conf_value Interface PrivateKey | wg set "$WG_IF" private-key /dev/stdin
wg set "$WG_IF" peer "$peer_pubkey" endpoint "$peer_endpoint" \
  allowed-ips 0.0.0.0/0,::/0 persistent-keepalive 25
ip addr add "$VPN_ADDR" dev "$WG_IF"
# The tunnel's IPv6 address is local (a route on lo), not an address of wg0: an interface
# address would be picked as the source of every unbound IPv6 socket here (tailscaled's own
# traffic included), which rule 110 would then send through the tunnel. Bound sockets (the
# health probe; net.ipv6.ip_nonlocal_bind) and forwarded traffic (SNAT) use it; it also
# survives wg0 going down, which flushes interface IPv6 addresses.
if [ -n "$VPN_ADDR6" ]; then ip -6 route replace local "$VPN_SRC6/128" dev lo table local; fi
ip link set "$WG_IF" mtu "${WG_MTU:-1420}" up
ip route replace default dev "$WG_IF" table "$EXIT_TABLE"
# IPv6 too (forwarded IPv6 then waits for the gate in nftables). Metric 1: IPv6 routes
# default to 1024, which would lose to the unreachable routes' 1000.
if [ -n "$VPN_ADDR6" ]; then
  ip -6 route replace default dev "$WG_IF" metric 1 table "$EXIT_TABLE"
  ip -6 route replace default dev "$WG_IF" metric 1 table "$TUNNEL6_TABLE"
fi
log "tunnel up: peer ${PEER_NAME:-from-config} $peer_endpoint, address $VPN_ADDR ${VPN_ADDR6:-(no IPv6)}"
