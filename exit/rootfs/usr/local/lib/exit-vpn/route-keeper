#!/command/with-contenv sh
# Longrun, the owner of the routes via wg0 and of the IPv6 gate. The kernel deletes routes via
# wg0 when the link goes down, so put them back whenever wg0 is up again; while wg0 is down,
# the unreachable routes hold and exit traffic fails closed. Forwarded IPv6 passes only while
# the gate file (written by the controller) exists: route-keeper then puts wg0 in nftables'
# ipv6_gate set; otherwise the kill switch refuses new IPv6 connections at once (clients use
# IPv4) and lets open ones carry on.
. /usr/local/lib/exit-vpn/common.sh
load_conf
set +e   # a failed command is retried on the next pass, never the end of the keeper
has_default() { ip "$1" route show table "$2" | grep -q "^default dev $WG_IF"; }
gate_open() { nft get element inet killswitch ipv6_gate "{ $WG_IF }" >/dev/null 2>&1; }
while :; do
  if ip link show "$WG_IF" up 2>/dev/null | grep -q 'state UP\|state UNKNOWN'; then
    if ! has_default -4 "$EXIT_TABLE"; then
      ip route replace default dev "$WG_IF" table "$EXIT_TABLE" && log "restored default dev $WG_IF in table $EXIT_TABLE"
    fi
    if [ -n "$VPN_ADDR6" ]; then
      # metric 1: below the unreachable routes' 1000 (IPv6 routes default to 1024)
      for t in "$EXIT_TABLE" "$TUNNEL6_TABLE"; do
        has_default -6 "$t" || ip -6 route replace default dev "$WG_IF" metric 1 table "$t"
      done
    fi
  fi
  if [ -n "$VPN_ADDR6" ] && [ -e "$IPV6_GATE" ]; then
    gate_open || { nft add element inet killswitch ipv6_gate "{ $WG_IF }" && log "IPv6 gate open: forwarded IPv6 via $WG_IF"; }
  elif gate_open; then
    nft delete element inet killswitch ipv6_gate "{ $WG_IF }" && log "IPv6 gate closed: new forwarded IPv6 refused"
  fi
  sleep 1
done
