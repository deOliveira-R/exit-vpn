#!/bin/sh
# Docker healthcheck: the active tunnel passes traffic. (The controller's health loop
# is the real failure detector; this only feeds `docker ps`.)
. /usr/local/lib/exit-vpn/common.sh
active=$(active_if)
ip link show "$active" >/dev/null 2>&1 || exit 1
curl -fsS --max-time 10 --interface "$active" https://www.cloudflare.com/cdn-cgi/trace >/dev/null
