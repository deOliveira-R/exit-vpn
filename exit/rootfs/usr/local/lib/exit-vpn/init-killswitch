#!/command/with-contenv sh
# Kill switch, layer 1 (routing) and layer 2 (nftables). Runs before the
# tunnels or tailscaled exist, so nothing can leave the wrong way during startup.
. /usr/local/lib/exit-vpn/common.sh
load_conf

# nftables: our own tables, rendered with this config's values. Atomic load.
mkdir -p /run/exit-vpn
cat > /run/exit-vpn/defines.nft <<NFT
define TUNNELS = { "$WG_IF", "$STANDBY_IF" }
define VPN_DNS = $VPN_DNS
NFT
nft -f /etc/exit-vpn/killswitch.nft
# IPv6 exit traffic leaves from the tunnel's address (not on an interface, so not masquerade)
if [ -n "$VPN_SRC6" ]; then
  nft add rule inet nat_exit postrouting oifname "{ $WG_IF, $STANDBY_IF }" meta nfproto ipv6 snat ip6 to "$VPN_SRC6"
fi

# Routing: every table falls back to unreachable; the defaults via the tunnels are added by
# init-wg (and kept by route-keeper).
for t in "$EXIT_TABLE" "$(tunnel_table "$WG_IF")" "$(tunnel_table "$STANDBY_IF")"; do
  ip route replace unreachable default metric 1000 table "$t"
  ip -6 route replace unreachable default metric 1000 table "$t"
done
rule() { # family priority selector...
  fam=$1; prio=$2; shift 2
  ip "$fam" rule del priority "$prio" 2>/dev/null || true
  ip "$fam" rule add priority "$prio" "$@"
}
for fam in -4 -6; do
  rule "$fam" 100 iif tailscale0 lookup "$EXIT_TABLE"   # forwarded exit traffic → the active tunnel
  rule "$fam" 105 oif "$WG_IF" lookup "$(tunnel_table "$WG_IF")"            # sockets bound to wg0
  rule "$fam" 106 oif "$STANDBY_IF" lookup "$(tunnel_table "$STANDBY_IF")"  # sockets bound to wg1
done
rule -4 90  to 100.64.0.0/10       lookup 52            # tailnet destinations → Tailscale's table
rule -6 90  to fd7a:115c:a1e0::/48 lookup 52
rule -4 110 from "$VPN_SRC"        lookup "$EXIT_TABLE"  # sockets bound to the tunnel address
rule -4 120 to "$VPN_DNS"          lookup "$EXIT_TABLE"  # VPN DNS only via the tunnel
if [ -n "$VPN_ADDR6" ]; then
  rule -6 110 from "$VPN_SRC6"     lookup "$EXIT_TABLE"
else
  ip -6 rule del priority 110 2>/dev/null || true
fi
ip -6 route flush table 101 2>/dev/null || true   # the former own-IPv6 table, now per tunnel
rm -f "$IPV6_GATE" "$ACTIVE_FILE"   # IPv6 closed until proven; wg0 active
log "kill switch loaded (tunnels $TUNNELS, table $EXIT_TABLE, dns $VPN_DNS, ipv6 ${VPN_SRC6:-off})"
