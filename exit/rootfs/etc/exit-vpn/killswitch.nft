# Kill switch layer 2. $WG_IF and $VPN_DNS come from defines.nft, written by
# init-killswitch from the WireGuard config. Our tables are replaced atomically on reload.
include "/run/exit-vpn/defines.nft"

table inet killswitch
delete table inet killswitch
table inet killswitch {
  # The IPv6 gate: route-keeper puts wg0 here while the controller has proven IPv6 on this
  # server. Otherwise forwarded IPv6 is refused at once, TCP with a reset (an ICMP error alone
  # is dropped by Tailscale clients, whose connections then stall), so clients use IPv4.
  set ipv6_gate { type ifname; }
  chain forward {
    type filter hook forward priority -10; policy accept;
    # Exit traffic may only leave through the tunnel. A drop here is final, whatever
    # tailscaled's own ts-forward chains accept.
    iifname "tailscale0" oifname != $WG_IF drop
    iifname "tailscale0" meta nfproto ipv6 oifname != @ipv6_gate meta l4proto tcp reject with tcp reset
    iifname "tailscale0" meta nfproto ipv6 oifname != @ipv6_gate reject with icmpx admin-prohibited
  }
  chain output {
    type filter hook output priority -10; policy accept;
    # The VPN's DNS server must never be asked over the underlay.
    ip daddr $VPN_DNS oifname != $WG_IF drop
  }
}

# Clients' tailnet sources become the tunnel's addresses: IPv4 here, IPv6 (snat to the
# tunnel's IPv6 address) added by init-killswitch when the config has one
table inet nat_exit
delete table inet nat_exit
table inet nat_exit {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
    oifname $WG_IF meta nfproto ipv4 masquerade
  }
}

table inet mss
delete table inet mss
table inet mss {
  chain forward {
    type filter hook forward priority 0; policy accept;
    oifname $WG_IF tcp flags syn tcp option maxseg size set rt mtu
  }
}
