// Example/default ACLs for unrestricted connections.
{
    // Declare static groups of users. Use autogroups for all users or users with a specific role.
    // "groups": {
    //   "group:example": ["alice@example.com", "bob@example.com"],
    // },

    // Define grants that govern access for users, groups, autogroups, tags,
    // Tailscale IP addresses, and subnet ranges.
    "grants": [
        // Your own devices (Mac, iPhone): the home LAN and the NAS, everything
        {
            "src": ["autogroup:member"],
            "dst": ["<HOME_LAN_CIDR>", "tag:nas"],
            "ip":  ["*"],
        },
        // Your own devices → the Oracle server
        {"src": ["autogroup:member"], "dst": ["tag:server"], "ip": ["*"]},
        // No rule for tag:server → it can reach nothing on your tailnet

        // Your own devices may use exit nodes (exit-proton)
        {"src": ["autogroup:member"], "dst": ["autogroup:internet"], "ip": ["*"]},
        // Your own devices → exit nodes: ping only for now (controller API tcp:8080 in Phase 3)
        {"src": ["autogroup:member"], "dst": ["tag:exit"], "ip": ["icmp:*"]},
        // No rule for tag:exit → it can reach nothing on your tailnet
    ],

    // Define users and devices that can use Tailscale SSH.
    "ssh": [
        // Allow all users to SSH into their own devices in check mode.
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self"],
            "users":  ["autogroup:nonroot", "root"],
        },
    ],

    "nodeAttrs": [
        {
            // Funnel policy, which lets tailnet members control Funnel
            // for their own devices.
            "target": ["autogroup:member"],
            "attr": ["funnel"],
        },
    ],

    "tagOwners": {
        "tag:nas": ["autogroup:admin"],

        // External servers
        "tag:server": ["autogroup:admin"],

        // VPN-backed exit nodes (exit-proton, ...)
        "tag:exit": ["autogroup:admin"],
    },

    // Exit nodes tagged tag:exit are approved without a manual click
    "autoApprovers": {
        "exitNode": ["tag:exit"],
    },

    // Test access rules every time they're saved.
    "tests": [
        {"src": "tag:server", "deny": ["<NAS_LAN_IP>:443", "tag:nas:443"]},
        // A compromised exit node reaches nothing: not the server, the NAS or the LAN
        {"src": "tag:exit", "deny": ["tag:server:22", "tag:server:443", "tag:nas:443", "<NAS_LAN_IP>:443"]},
        // ...and the server cannot reach the exit node
        {"src": "tag:server", "deny": ["tag:exit:8080"]},
    ],
}
